# Security report A-05 : règle de repli (voir .htaccess à la racine du module). Contient le rapport de
# sécurité lui-même et ses preuves — à ne jamais servir publiquement.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
