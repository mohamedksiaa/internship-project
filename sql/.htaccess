# Security report A-05 : règle de repli (voir .htaccess à la racine du module). Ces schémas ne sont lus que
# côté serveur, par Dolibarr lui-même à l'activation du module (jamais par une requête HTTP du navigateur) ;
# les bloquer ne touche pas à l'installation.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
