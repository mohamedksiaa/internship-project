# Security report A-05 : règle de repli (voir .htaccess à la racine du module). Fichiers de traduction, lus
# uniquement côté serveur par $langs->load(), jamais par le navigateur.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
